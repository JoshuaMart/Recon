# Copy to .env and fill in. .env is git-ignored and never committed.
#
# Every value here is a local development credential. Production secrets live
# in the deployment, never in a file next to the source (13.6).

# The owner role. Runs migrations and the bootstrap, never the application.
POSTGRES_USER=asm_owner
POSTGRES_PASSWORD=
POSTGRES_DB=recon
POSTGRES_PORT=5432

# The application role, and the one that crosses tenants. Two credentials
# rather than one: what separates them is what row-level security lets them
# see, so sharing a password would turn that distinction into a comment.
APP_PASSWORD=
SYSTEM_PASSWORD=

# Where continuous archiving writes. A path locally, a bucket in production.
# The restore is exercised against whatever this names.
#
# Relative paths resolve against deploy/compose, which is where the compose
# file lives, so the default below is the repository's var/archive. An absolute
# path works too and is clearer if you move the archive elsewhere.
BACKUP_ARCHIVE_DIR=../../var/archive

# What signs a run's credentials. At least 32 bytes: a guessable key is not a
# weak configuration, it is an unsigned one. Generate with `openssl rand -hex 32`.
SIGNING_KEY=

# Geo-IP, optional. A deployment with neither is normal, and the console is
# told which of the two it is rather than guessing from data that looks the
# same either way. Paths are inside the container; the directory below is
# mounted at /geoip.
# Left unset on purpose. A path that is set and unreadable is an error, because
# somebody configured it, so filling these in before the files exist stops the
# control plane from starting at all.
GEOIP_DIR=../../var/geoip
# Uncomment once the two files are in GEOIP_DIR. Having them there is not
# enough: the paths are what the control plane reads, so a directory full of
# databases nobody declared is a deployment that answers "not configured" and a
# console that correctly shows no infrastructure family at all. The paths are
# the ones inside the container, which is where GEOIP_DIR is mounted.
# GEOIP_CITY_DATABASE=/geoip/GeoLite2-City.mmdb
# GEOIP_ASN_DATABASE=/geoip/GeoLite2-ASN.mmdb

# The control plane's API. Loopback by default; a deployment whose scanner runs
# off-host binds 0.0.0.0 and accepts what the note on PUBLIC_URL says.
CONTROLPLANE_BIND=127.0.0.1
CONTROLPLANE_PORT=8080

# The console. ORIGIN is not optional outside development: the node adapter
# compares the Origin header of a POST against the origin it believes it serves,
# and without it it infers that badly and rejects legitimate POSTs, the login
# screen included. The fault then shows at the first form rather than at
# startup, which is the worst moment to discover it. Set it to the URL the
# console is actually served on.
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=3000
CONSOLE_ORIGIN=http://localhost:3000


# Where a run reaches the control plane, for its target list and its report.
# It cannot be derived from the listen address: the scanner runs somewhere else
# entirely, and locally that is another container. Set it to a host the scanner
# can actually resolve.
PUBLIC_URL=http://controlplane:8080

# The fingerprinter, on the scan network. It holds no credential: everything
# it needs arrives in the scan request.
FINGERPRINTER_PORT=3001

# Where the control plane reaches it. Locally that is the host gateway rather
# than the service name: joining the scan network would let the browser side
# resolve postgres and controlplane, which is the one thing the split exists to
# prevent. Empty turns rendering off, and a deployment that only probes is a
# normal deployment: the assets keep their due dates and nothing pretends to
# have looked at them.
RENDER_URL=http://host.docker.internal:3001

# The Certificate Transparency feed, on the scan network for the same reason:
# its input is public certificates anybody can get logged, and it has no
# business reaching the database. It holds no credential either, since
# everything it reads is public.
CERTSTREAM_PORT=3002

# Where the control plane dials it, through the host gateway for the same reason
# the renderer is reached that way. Empty turns the matcher off: periodic
# enumeration still walks every perimeter, and what is given up is the freshness
# advantage rather than coverage.
#
# The lite path. /domains-only is fifteen times smaller on the wire and drops the
# issuer and the log, which is the whole of a candidate's lineage.
CT_URL=ws://host.docker.internal:3002/

# How a run is actually started. "none" renders the definition and starts
# nothing, which is the development shape: the console shows it and a person
# runs the image. "scaleway" starts the serverless job definition named below.
RUNNER_PROVIDER=none
RUNNER_REGION=fr-par
RUNNER_JOB_ID=

# The only credential the runner needs, and it is the whole of what a
# compromised control plane could spend. Scope it to starting this definition
# and to nothing else on the account: it sits in the process that already holds
# the inventory. Scaleway calls it a secret key and sends it in X-Auth-Token;
# the access key is for object storage and is not used here.
RUNNER_SECRET_KEY=

# Where alerts go. One generic webhook, and Discord and Slack are a payload
# template rather than a connector. Empty is a deliberate configuration and not
# an outage: events are computed, marked delivered and counted, so "sent
# nowhere" stays visible instead of looking like a queue that drains.
#
# The URL of a Discord webhook is itself the credential, so it lands in the
# database on the row that carries it. That is the trade of a per organization
# channel, and it is worth knowing rather than discovering.
NOTIFY_WEBHOOK_URL=

# The floor this channel wants: critical, high, medium or low.
NOTIFY_MIN_PRIORITY=low



# ─────────────────────────────────────────────────────────────────────────────
# Tuning. Everything below is optional: leave a line commented and the default
# in internal/config applies, which is the one place it is written down. An
# empty value is not the same as an absent one and will stop the process, so
# comment the line out rather than clearing it.
#
# Durations are Go durations: 30s, 15m, 72h. There is no day unit, so a week is
# 168h.
# ─────────────────────────────────────────────────────────────────────────────

# How often an asset is re-checked. These are the numbers that decide how much
# traffic this system sends and how much it costs to run.
#
# RESOLVE is a DNS resolution and nothing else: one round trip to a resolver,
# nothing sent to the target. It says whether the name still resolves, not
# whether the service answers.
#
# FULL is the expensive rung and it runs every rung below it: resolve, a port
# sweep, an HTTP probe. It is also the only thing that can conclude an asset is
# gone, because only a run over an explicit target list makes a missing answer
# mean something. A discovery run carries the same rung, so it pushes this date
# out for everything it enumerates: raising FULL to the discovery interval
# removes the overlap and leaves this pass covering what enumeration no longer
# returns, which is exactly what needs it.
# RECON_VERIFICATION__RESOLVE=24h
# RECON_VERIFICATION__FULL=72h

# The render cadences, one per reachability regime, because which observer gets
# through decides what a render is worth. Nominal when both do; the fingerprinter
# alone when the raw client is blocked, so it runs at a detector's rate; a rare
# recovery attempt when the fingerprinter is the one being turned away; and
# short when neither gets through, because the asset is unmeasurable rather than
# dead and something has to keep asking.
# RECON_VERIFICATION__FINGERPRINT=504h
# RECON_VERIFICATION__RENDER_SOLE=168h
# RECON_VERIFICATION__RENDER_RECOVERY=720h
# RECON_VERIFICATION__RENDER_BLIND=168h

# The low rate a confirmed death is still watched at. An inventory that stops
# looking at what died never notices it come back.
# RECON_VERIFICATION__INACTIVE=168h

# The ceiling of the spread added to every delay, applied as a fraction of the
# delay rather than added flat. Without it the thousands of assets one discovery
# run writes share a due date to the microsecond and come back together forever,
# in a spike every cycle.
# RECON_VERIFICATION__JITTER=15m

# How fast the expensive rung may be asked to confirm a failure. A backoff curve
# is written for the cheap rung, where fifteen minutes costs one round trip; the
# same fifteen minutes on the full rung is a hundred connections per host four
# times an hour, against a target that is answering. The nominal cadence above
# is never affected: this is a floor on a backoff.
# RECON_VERIFICATION__FULL_FLOOR=6h

# How many hosts one verification run freezes. Everything due beyond it waits
# for the next tick, so this bounds the size of a run rather than the work.
# RECON_VERIFICATION__BATCH_SIZE=500

# How often the three run loops look: the pass on due dates, the discovery
# cadence and the deadline sweeper. It decides how fast they react and not how
# much they start, because a tick that finds nothing due starts nothing. Short
# is what makes a hand entered asset go out at once.
# RECON_VERIFICATION__SWEEP_INTERVAL=1m

# The budget a run has before the deadline sweeper expires it. It has to stay
# under the platform's own timeout, so that a long run delivers a truncated
# report instead of being killed with nothing.
# RECON_VERIFICATION__TIMEOUT=30m

# How long before a discovery that ended without delivering is retried. Without
# it a run that failed in thirty seconds costs a whole discovery interval of
# coverage.
# RECON_VERIFICATION__DISCOVERY_RETRY=1h

# The port list a run sweeps. Not nmap's top 100, which orders ports by how
# often they are open across the whole internet and therefore leads with mail
# and printing: the criterion here is that a port earns its place if it can
# carry a finding.
# RECON_VERIFICATION__PORTS=80,443,8080,8443,...

# The render pass. INTERVAL is how often it looks, BATCH how many due assets it
# takes in one pass, CONCURRENCY how many renders are in flight at once.
#
# COST is what one render is charged against a programme's rate limit, and it is
# thirty rather than one because a browser fetches the page, its same host
# subresources, the scripts, the stylesheets, the images, the XHRs the page
# issues, then the 404 probe, robots.txt, the sitemap and the favicon. Billing it
# as one request would make the most expensive thing in the system the cheapest
# on the counter. Concurrency is set above where the budget binds, so what
# throttles a programme is its published rate limit rather than a number nobody
# calibrated.
# RECON_RENDER__INTERVAL=1m
# RECON_RENDER__BATCH=200
# RECON_RENDER__CONCURRENCY=8
# RECON_RENDER__COST=30
# RECON_RENDER__TIMEOUT=2m

# How often the notifier drains what ingestion produced. Producing an event is
# ingestion's job, in its transaction; sending it can lag without consequence.
# RECON_NOTIFY__INTERVAL=30s

# How often the external host sweep asks whether a third party domain still
# resolves. Six hours, because a domain expiring is a step that stays rather
# than a transient. Zero turns it off, for a deployment that would rather make
# no outbound query at all.
# RECON_EXTERNAL__INTERVAL=6h

# How often the partition and housekeeping loop runs. It creates next month's
# partitions, and a row whose month is missing fails loudly rather than landing
# somewhere it has to be found later.
# RECON_MAINTENANCE__INTERVAL=1h
