# Copy to .env and fill in. Never committed.
POSTGRES_PASSWORD=change-me
# At least 32 characters: openssl rand -hex 32
RECON_API_KEY=
RECON_PUBLIC_URL=http://localhost:8080

# Shared by Recon and the fastrecon service: openssl rand -hex 32
FASTRECON_API_TOKEN=

# ScopesExtractor, reached from the recon container. Leave the URL empty for
# manual programs only. On the same host: http://host.docker.internal:4567
SCOPES_EXTRACTOR_URL=
SCOPES_EXTRACTOR_API_KEY=

# Periodic probing of every in-scope host of every active program. Off until you
# decide to: it scans real targets from this machine.
VERIFICATION_ENABLED=false

# Notifications. Without a channel they are only listed on the settings page.
# A Discord webhook URL (Server settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=
# Or any URL receiving a JSON body, with an optional "Name: value" header.
WEBHOOK_URL=
WEBHOOK_HEADER=

# Optional
# FASTRECON_IMAGE=ghcr.io/joshuamart/fastrecon:main
# CHAOS_API_KEY=
# SECURITYTRAILS_API_KEY=
# C99_API_KEY=
# AUTO_SCAN=off
# RECON_PORT=8080
# RECON_LOG_LEVEL=info
# BACKUP_HOUR=3
# BACKUP_RETENTION_DAYS=14
